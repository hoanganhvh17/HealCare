# =====================================================================
#  BIẾN MÔI TRƯỜNG CHO PRODUCTION — chép thành .env (đã gitignore) rồi điền
# =====================================================================
# Danh sách này khớp 1-1 với các ${...} trong src/main/resources/application.properties.
# Kiểm lại bất cứ lúc nào bằng:  grep -o '\${[A-Z_]*' src/main/resources/application.properties | sort -u
#
# ---------------------------------------------------------------------
#  HAI LUẬT VỀ ĐỊNH DẠNG — KHÔNG PHẢI CHUYỆN THẨM MỸ
# ---------------------------------------------------------------------
# Tệp này được nạp bởi `EnvironmentFile=` của systemd (deploy/nnlhospital.service)
# và bởi `.` của bash (deploy/backup.sh). Cả hai đều KHÔNG phải shell đầy đủ:
#
#  (1) KHÔNG có bình luận cuối dòng. systemd chỉ bỏ qua dòng bắt đầu bằng #.
#      `SCHEMA_STRICT=true   # ghi chú` gán nguyên chuỗi "true   # ghi chú",
#      Spring ném lỗi ép kiểu boolean và app KHÔNG khởi động được — mà thông báo
#      lỗi lại chỉ nói về boolean, không hề nhắc tới dấu #.
#
#  (2) Giá trị chứa dấu cách hoặc ký tự đặc biệt (& ? *) PHẢI đặt trong nháy kép.
#      App password của Gmail có dấu cách; NEWS_FETCH_CRON có cả dấu cách lẫn *
#      và ?; DB_URL có &  — và dấu & không đặt nháy sẽ khiến bash trong backup.sh
#      cắt dòng làm đôi rồi chạy nền, tức mật khẩu DB biến mất mà không báo gì.
#
# Đặt bình luận lên dòng riêng phía trên biến, như toàn bộ tệp này đang làm.
# =====================================================================


# ---------------------------------------------------------------------
#  ỨNG DỤNG
# ---------------------------------------------------------------------
SERVER_PORT=8090

# BẮT BUỘC. Dùng để dựng URL VNPay trả kết quả về và header Referer gửi OpenRouter.
# Phải là domain thật kèm https, KHÔNG kèm dấu / ở cuối.
APP_BASE_URL="https://nnlhospital.example.com"


# ---------------------------------------------------------------------
#  CƠ SỞ DỮ LIỆU
# ---------------------------------------------------------------------
DB_URL="jdbc:mysql://localhost:3306/bookinghealthy?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=Asia/Ho_Chi_Minh"
DB_USERNAME="bookinghealthy"
DB_PASSWORD=""

# Lần boot ĐẦU TIÊN trên DB rỗng để `update` cho Hibernate dựng lược đồ.
# Sau khi đã chạy db/manual/*.sql thì đổi thành `validate` để tránh Hibernate âm thầm
# ALTER production mỗi khi có ai sửa entity.
DDL_AUTO=update


# ---------------------------------------------------------------------
#  CHẾ ĐỘ PRODUCTION
# ---------------------------------------------------------------------
# true sẽ đổ tên và số điện thoại bệnh nhân vào log.
SHOW_SQL=false

# false sẽ biên dịch lại template mỗi request.
THYMELEAF_CACHE=true

# Có HTTPS thì bật.
COOKIE_SECURE=true

# SchemaGuard kiểm 4 đối tượng của db/manual/*.sql lúc khởi động.
#
# LẦN BOOT ĐẦU TIÊN PHẢI ĐỂ false. Lúc đó DB còn rỗng nên uk_bookings_slot,
# uk_posts_source_url, shedlock và SPRING_SESSION đều chưa tồn tại — để true là
# SchemaGuard chặn khởi động đúng lúc cần Hibernate dựng bảng, và bước 4 của
# README.md không bao giờ chạy được.
#
# Chạy xong db/manual/001 + 002 thì ĐỔI THÀNH true rồi khởi động lại. Quên bước
# đó thì một lần quên migration về sau trông y hệt lúc mọi thứ bình thường, cho
# tới ngày hai bệnh nhân đặt trúng một khung giờ.
SCHEMA_STRICT=false

FORWARD_HEADERS=framework


# ---------------------------------------------------------------------
#  MAIL (Gmail app password)
# ---------------------------------------------------------------------
# Gmail miễn phí giới hạn ~500 thư/ngày. Ứng dụng gửi nhắc lịch khám (07:30),
# nhắc tái khám (08:00), thư hồ sơ bệnh án sau mỗi ca khám và thư xác nhận đặt
# lịch — lượng người dùng tăng là chạm trần, biểu hiện ra ngoài chỉ là thư không
# tới. Vượt thì chuyển sang Brevo (300 thư/ngày) hoặc Resend (3.000 thư/tháng):
# chỉ cần đổi ba biến dưới đây, mã nguồn không phải sửa gì.
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME=""
# App password của Google có dấu cách giữa các nhóm 4 ký tự — bắt buộc đặt nháy kép.
MAIL_PASSWORD=""


# ---------------------------------------------------------------------
#  OAUTH2
# ---------------------------------------------------------------------
# Nhớ đăng ký redirect URI trong console của Google/Facebook:
#   https://<domain>/login/oauth2/code/google
#   https://<domain>/login/oauth2/code/facebook
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""


# ---------------------------------------------------------------------
#  TRỢ LÝ AI
# ---------------------------------------------------------------------
AI_API_URL="https://openrouter.ai/api/v1/chat/completions"
OPENROUTER_API_KEY=""


# ---------------------------------------------------------------------
#  VNPAY (vẫn đang sandbox)
# ---------------------------------------------------------------------
VNPAY_PAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNPAY_API_URL="https://sandbox.vnpayment.vn/merchant_webapi/api/transaction"
VNPAY_TMN_CODE=""
VNPAY_HASH_SECRET=""


# ---------------------------------------------------------------------
#  CHUYỂN KHOẢN NGÂN HÀNG
# ---------------------------------------------------------------------
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=""
VIETQR_ACCOUNT_NAME="VU HUU HOANG ANH"
VIETQR_MEMO_PREFIX=HEALCARE

# BẮT BUỘC nếu dùng webhook. Sinh bằng: openssl rand -hex 32
# Để RỖNG là webhook từ chối mọi request — an toàn hơn hẳn việc mở toang cho cả internet.
# Khai đúng chuỗi này bên Casso (header Secure-Token) hoặc SePay (Authorization: Apikey ...).
PAYMENT_WEBHOOK_SECRET=""


# ---------------------------------------------------------------------
#  THƯ MỤC TỆP
# ---------------------------------------------------------------------
# Phải là ổ đĩa BỀN, không phải lớp ghi của container. Nhớ copy sẵn 133 ảnh bác sĩ
# được git theo dõi trong uploads/ của repo vào đây — chúng KHÔNG nằm trong jar.
UPLOAD_DIR="/var/lib/nnlhospital/uploads"

# CV ứng viên. KHÔNG được nằm dưới UPLOAD_DIR (thư mục đó phục vụ công khai).
PRIVATE_DIR="/var/lib/nnlhospital/private"


# ---------------------------------------------------------------------
#  DỮ LIỆU KHỞI TẠO
# ---------------------------------------------------------------------
# Sau lần boot đầu tiên có thể đặt false.
SEED_ENABLED=true

SEED_ADMIN_USERNAME=admin

# BẮT BUỘC ĐỔI. Để trống là app dùng "admin123" — một tài khoản quản trị đoán được
# trên site y tế công khai là sự cố ngay ngày đầu.
SEED_ADMIN_PASSWORD=""

# Bỏ patient_tom / testsang31.
SEED_DEMO_ACCOUNTS=false

# Mật khẩu chung cho ~132 bác sĩ, yêu cầu họ đổi ngay khi đăng nhập lần đầu.
SEED_DOCTOR_PASSWORD=""


# ---------------------------------------------------------------------
#  LỊCH CHẠY NGẦM
# ---------------------------------------------------------------------
SCHEDULER_POOL_SIZE=4
NEWS_FETCH_ENABLED=true
# Có dấu cách, * và ? — bắt buộc đặt nháy kép.
NEWS_FETCH_CRON="0 0 6,18 * * ?"
NEWS_FETCH_MAX_PER_RUN=2
NEWS_FETCH_MAX_AGE_DAYS=3


# ---------------------------------------------------------------------
#  MÚI GIỜ CỦA TIẾN TRÌNH
# ---------------------------------------------------------------------
# BookingHealthyApplication tự đặt TimeZone mặc định của JVM, nhưng đặt thêm ở đây để
# log của hệ thống và MySQL cùng một múi giờ.
TZ="Asia/Ho_Chi_Minh"
